# ---------------------------------------------------------------------------
# Identifiants d'envoi d'e-mail.  Copiez ce fichier en « .env » puis complétez.
# Le fichier .env ne doit jamais être partagé ni versionné.
# ---------------------------------------------------------------------------

# Gmail : activez la validation en deux étapes sur le compte, puis créez un
# « mot de passe d'application » sur https://myaccount.google.com/apppasswords
# et collez ici les 16 caractères (sans espaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=adresse.expediteur@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# Expéditeur affiché (laissez vide pour reprendre SMTP_USERNAME)
MAIL_FROM=

# Destinataires, séparés par des virgules
MAIL_TO=papa@example.com,moi@example.com

# ---------------------------------------------------------------------------
# Interface web — uniquement si vous l'ouvrez au réseau local
# ---------------------------------------------------------------------------
# Mot de passe partagé demandé par le navigateur (n'importe quel identifiant,
# seul le mot de passe est vérifié). Laissez vide pour ne rien demander.
WEB_PASSWORD=

# Se règlent aussi dans config.yaml ; ici pour un poste particulier.
# WEB_HOST=0.0.0.0
# WEB_PORT=8765
